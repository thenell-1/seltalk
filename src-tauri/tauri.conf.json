{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelTalk",
  "version": "0.1.0",
  "identifier": "com.seltalk.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "manager",
        "title": "择言 - 管理面板",
        "url": "manager.html",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "float",
        "title": "择言",
        "url": "float.html",
        "width": 420,
        "height": 360,
        "minWidth": 320,
        "minHeight": 240,
        "center": false,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {}
}
